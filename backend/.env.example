# Environment
NODE_ENV=development
PORT=5000

# Security (JWT_SECRET must be at least 32 characters long)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-in-prod
JWT_EXPIRE=7d

# Database
MONGODB_URI=mongodb://localhost:27017/kasturi-ayurveda

# CORS & Frontend
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# Email Configuration (Optional for now)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=Kasturi Ayurveda <kasturiayurvedahyd@gmail.com>

# Admin Credentials (for createAdmin script)
ADMIN_EMAIL=admin@kasturiayurveda.com
ADMIN_PASSWORD=your-strong-admin-password-min-12-chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Payments (Razorpay). Must be exactly "true" or "false".
# false (default): online + pay_now bookings rejected, payment routes 404,
# Razorpay vars below not required.
# true: all three Razorpay vars are required or the server won't start.
# Use TEST keys (rzp_test_...) everywhere except production; a live key
# outside NODE_ENV=production makes the server refuse to start.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when creating the webhook in the Razorpay dashboard (not the key secret)
RAZORPAY_WEBHOOK_SECRET=
