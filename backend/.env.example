# Environment
NODE_ENV=development
PORT=5000
# Optional: debug | info | warn | error | silent (default: info; silent in tests).
# Production logs are JSON lines; development logs are human-readable.
# LOG_LEVEL=info

# Security (JWT_SECRET must be at least 32 characters long)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-in-prod
JWT_EXPIRE=7d

# Database
MONGODB_URI=mongodb://localhost:27017/kasturi-ayurveda

# CORS & Frontend
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080

# Transactional email (required). EMAIL_PROVIDER: resend | brevo | log
# ("log" = development only, sends nothing; refused in production).
# EMAIL_FROM must be a sender address verified with the provider.
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM=Kasturi Ayurveda <bookings@example.com>
# Optional: clinic inbox for "new booking / new message" notifications
CLINIC_NOTIFY_EMAIL=

# Scheduler (required, 32+ chars). Same value goes in the GitHub repo
# secret CRON_SECRET used by .github/workflows/scheduled-jobs.yml.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Admin Credentials (for createAdmin script)
ADMIN_EMAIL=admin@kasturiayurveda.com
ADMIN_PASSWORD=your-strong-admin-password-min-12-chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Payments (Razorpay). Must be exactly "true" or "false".
# false (default): online + pay_now bookings rejected, payment routes 404,
# Razorpay vars below not required.
# true: all three Razorpay vars are required or the server won't start.
# Use TEST keys (rzp_test_...) everywhere except production; a live key
# outside NODE_ENV=production makes the server refuse to start.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when creating the webhook in the Razorpay dashboard (not the key secret)
RAZORPAY_WEBHOOK_SECRET=

# Google Meet links (required when PAYMENTS_ENABLED=true). OAuth "Desktop
# app" client from Google Cloud; refresh token from `npm run google-auth`
# signed in as the clinic's Google account. See docs/SETUP_PHASE6.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
